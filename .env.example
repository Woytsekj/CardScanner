# MTG Scanner Inventory - Cloudflare public deployment
# Cloudflare terminates HTTPS and tunnels to the localhost-bound Docker service.
REQUIRE_LOGIN=1
PUBLIC_HTTPS=1
SESSION_LIFETIME_HOURS=12

# Public Cloudflare hostname. Do not include scheme/port.
PUBLIC_HOSTNAME=cards.stinkywar.com
# Exact local hosts/IPs that may access the app directly over HTTP.
LOCAL_HOSTS=127.0.0.1,localhost,192.168.4.27

# Docker host bind. 0.0.0.0 allows LAN access at http://SERVER-IP:5000.
# Keep TCP/5000 blocked at the router; Cloudflare Tunnel is the public path.
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=5000
# Additional exact Host values may be listed here if needed.
TRUSTED_HOSTS=cards.stinkywar.com

# Scanner -> server authentication. Generate a random value of at least 32 characters.
SCANNER_API_KEY='replace-with-a-long-random-scanner-key'

# Flask session secret. Generate a random value of at least 32 characters.
SESSION_SECRET='replace-with-a-long-random-session-secret'

# Initial admin bootstrap. Only used if the database has no users yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD='replace-with-an-initial-password-at-least-12-characters'

# Optional vendor bootstrap. Prefer creating accounts in Admin after first login.
VENDOR_USERNAME=vendor
VENDOR_PASSWORD='replace-with-vendor-password-at-least-12-characters'

# Login abuse protection
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_WINDOW_MINUTES=15

# Timezone / pricing / Discord
DISPLAY_TIMEZONE=America/New_York
PRICE_HISTORY_DAYS=365
DISCORD_WEBHOOK_URL=
PRICE_ALERT_ENABLED=1
PRICE_ALERT_LOOKBACK_DAYS=30
PRICE_ALERT_COOLDOWN_DAYS=7
PRICE_ALERT_MIN_DOLLARS=2.00
PRICE_ALERT_MIN_PERCENT=25
PRICE_ALERT_MIN_OWNED_VALUE_GAIN=10.00
PRICE_ALERT_MAX_PER_SYNC=10

# Optional: run containers as a non-root user (owner of ./data). Default 0 = root.
# APP_UID=1000
# APP_GID=1000

# Nightly SQLite database backups
# Runs every night at the configured local time and keeps only the newest 2 archives.
BACKUP_HOUR=2
BACKUP_MINUTE=0
BACKUP_TIMEZONE=America/New_York
BACKUP_RETENTION=2
BACKUP_CHECK_INTERVAL=30
