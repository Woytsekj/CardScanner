# Development-only PostgreSQL settings. Copy to .env.postgres; do not commit that file.
POSTGRES_DB=cardscanner_dev
POSTGRES_USER=cardscanner
POSTGRES_PASSWORD=replace-with-a-long-random-development-password
POSTGRES_PORT=5433

# Used by postgres_db.py and local migration tests.
CARD_SCANNER_POSTGRES_DSN=postgresql://cardscanner:replace-with-a-long-random-development-password@127.0.0.1:5433/cardscanner_dev
CARD_SCANNER_PG_POOL_MIN=1
CARD_SCANNER_PG_POOL_MAX=3
