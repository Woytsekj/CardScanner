# MTG Scanner client configuration

# Local/LAN example:
# set -gx MTG_SERVER_URL "http://192.168.1.x:5000"

# Public Cloudflare example:
set -gx MTG_SERVER_URL "https://cards.example.com"

# OCR acceleration: auto detects CUDA or AMD ROCm when supported.
# Use 0/cpu to force CPU. Use 1/gpu to force GPU initialization.
set -gx MTG_OCR_GPU "auto"
# Optional LAN-only server URL for troubleshooting/offline-home use.
# set -gx MTG_LOCAL_SERVER_URL "http://192.168.1.x:5000"

# Cloudflare Access Service Token (for automated scanner API requests).
# Leave blank when using LAN-only server access.
set -gx MTG_CF_ACCESS_CLIENT_ID ""
set -gx MTG_CF_ACCESS_CLIENT_SECRET ''

# Existing scanner API key. Single quotes are useful for keys containing ! or $.
set -gx MTG_SCANNER_API_KEY 'replace-with-a-long-random-secret'
set -gx MTG_SCANNER_DEVICE "main-computer"

# Phone camera / scrcpy
set -gx MTG_VIDEO_SOURCE "/dev/video9"
set -gx MTG_V4L2_DEVICE "9"
set -gx MTG_SCRCPY_CAMERA "1"
set -gx MTG_SCRCPY_CAMERA_FACING "back"
set -gx MTG_SCRCPY_CAPTURE_ORIENTATION "@90"
set -gx MTG_SCRCPY_CAMERA_ZOOM "1.8"

# Optional local fallback owners if the server cannot be reached.
set -gx MTG_SCANNER_OWNERS "Bob,Ann"
